{
    "sectionName": "fluidProperties",
    "sectionLabel": "Fluid Properties",
    "displayType": "form",
    "displayOrder": 5,
    "fields": [
        {
            "fieldName": "FluidName",
            "label": "Fluid Name",
            "type": "combobox",
            "fieldDisplayOrder":1,
            "mandatory":false,
            "options": [
                { "label": "Acetone", "value": "Acetone" },
                { "label": "Acetylene", "value": "Acetylene" },
                { "label": "Air", "value": "Air" },
                { "label": "Ammonia", "value": "Ammonia" },
                { "label": "Argon", "value": "Argon" },
                { "label": "Benzene", "value": "Benzene" },
                { "label": "Butane-n", "value": "Butane-n" },
                { "label": "Carbon Dioxide", "value": "Carbon Dioxide" },
                { "label": "Carbon Monoxide", "value": "Carbon Monoxide" }
            ],
            "defaultValue": {"id":"FluidName", "value":"Water"}, 
            "disabled": false,
            "visible": true,
            "infoText": "",
            "grid": 6,
            "dimensionName":"",
            "validations": []
        },
        {
            "fieldName": "SpGravity",
            "label": "Specific Gravity",
            "type": "number",
            "fieldDisplayOrder": 2,
            "mandatory": true,
            "defaultValue": "",
            "disabled": [
                {
                    "target":{
                        "id":"FluidName",   
                        "currentId":"SpGravity",
                        "symbol":"Calculate",
                        "expression":"FluidName == 'Water'",
                        "expressionReqFields":["FluidName"],
                        "value": true
                    },
                    "value": true
                }
                ],
            "visible": true,
            "infoText": "Pressure Specific Gravity",
            "grid": 6,
            "validations": [
                {
                    "id": "SpGravity",
                    "minValue": 0,
                    "message":{"type":"error","message":"Spgt0"}
                }
            ],
            "dimensionName": "",
            "regex": "/^[|0]?\\d*\\.?\\d*$/"
        },
        {
            "fieldName": "Viscosity",
            "label": "Viscosity",
            "type": "inputUom",
            "fieldDisplayOrder": 3,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Viscosity [μ]",
            "grid": 4,
            "dimensionName": [
                "viscosity",
                "viscositykin"
            ],
            "options": [],
            "validations": [
            
                {
                    "target": {
                        "id": "Viscosity",
                        "symbol": "Calculate",
                        "expression": "Viscosity>500",
                        "expressionReqFields": [
                            "Viscosity"
                        ],
                        "value": true
                    },
                   "message":{"type":"error","message":"Viscgt500"}
                }
            ],
            "regex": "/^[|0]?\\d*\\.?\\d*$/"
        },
        {
            "fieldName": "VaporPressure",
            "label": "Vapor Pressure",
            "type": "inputUom",
            "fieldDisplayOrder": 4,
            "mandatory": true,
            "defaultValue": "",
            "disabled": [
                {
                    "target":{
                        "id":"FluidName",
                        "currentId":"VaporPressure",
                        "symbol":"Calculate",
                        "expression":"FluidName == 'Water'",
                        "expressionReqFields":["FluidName"],
                        "value": true
                    },
                    "value": true
                }
            ],
            "visible": true,
            "infoText": "Vapor Pressure[Pv1]",
            "grid": 4,
            "dimensionName": [
                "abspressure"
            ],
            "validations": [
                {
                    "id": "VaporPressure",
                    "minValue": 0,
                    "message":{"type":"error","message":"VaporPressuregt0"}
                }
            ],
            "options": [],
            "regex": "/^[|0]?\\d*\\.?\\d*$/"
        },
        {
            "fieldName": "CriticalPressure",
            "label": "Critical Pressure",
            "type": "inputUom",
            "UomFieldName": "",
            "fieldDisplayOrder": 5,
            "mandatory": true,
            "defaultValue": "3208.200",
            "disabled": false,
            "visible": true,
            "infoText": "",
            "grid": 4,
            "dimensionName": ["abspressure"],
            "validations": [
                {
                    "id": "CriticalPressure",
                    "minValue": 0,
                    "message":{"type":"error","message":"CriticalPressuregt0"}
                }
            ],
            "regex": "/^[|0]?\\d*\\.?\\d*$/"
        }
    ]
    
},
{
    "sectionName": "pressureProperties",
    "sectionLabel": "Pressure Properties",
    "displayType": "form",
    "displayOrder": 6,
    "fields": [
        {
            "fieldName": "AtmPressure",
            "label": "Atmospheric",
            "type": "inputUom",
            "UomFieldName": "AtmPressureUOM",
            "fieldDisplayOrder": 1,
            "mandatory": true,
            "defaultValue": {
                "value": "14.696"
            },
            "disabled": false,
            "visible": true,
            "infoText": "Atmospheric Pressure [Patm]",
            "grid": 4,
            "dimensionName": [
                "abspressure"
            ],
            "validations": [
                {
                    "id": "AtmPressure",
                    "minValue": 0,
                    "message":{"type":"error","message":"AtmPressuregt0"}
                }
            ],
            "options": [
                {
                    "label": "psia",
                    "value": "psia"
                },
                {
                    "label": "kPa",
                    "value": "kPa"
                },
                {
                    "label": "bar",
                    "value": "bar"
                },
                {
                    "label": "atm",
                    "value": "atm"
                }
            ],
            "defaultUnit": {
                "label": "psia",
                "value": "psia"
            }
        },
        {
            "fieldName": "PumpPressureAtZeroFlow",
            "label": "Pump Pressure At Shut-off(Zero Flow)",
            "type": "inputUom",
            "UomFieldName": "PressureUOM",
            "fieldDisplayOrder": 2,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Shut-off Pump Pressure[Ppso]",
            "grid": 4,
            "dimensionName": [
                "pressure"
            ],
            "validations": [
                {
                    "target": {
                        "id": "PumpPressureAtZeroFlow",
                        "symbol": "Calculate",
                        "expression": "!ExistingBypassLinePressure && !PumpPressureAtZeroFlow && ExistingBypassLinePressure>PumpPressureAtZeroFlow",
                        "expressionReqFields": [
                            "ExistingBypassLinePressure",
                            "PumpPressureAtZeroFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"error","message":"ExistingBypassLineltp"}
                },
                {
                    "target": {
                        "id": "PumpPressureAtNormalProcessFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtNormalProcessFlow && !PumpPressureAtZeroFlow && PumpPressureAtNormalProcessFlow>PumpPressureAtZeroFlow",
                        "expressionReqFields": [
                            "PumpPressureAtZeroFlow",
                            "PumpPressureAtNormalProcessFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtNormalProcessFlowgtppazf"}
                }
            ],	
            "options": [
                {
                    "label": "psia",
                    "value": "psia"
                },
                {
                    "label": "kPa",
                    "value": "kPa"
                },
                {
                    "label": "bar",
                    "value": "bar"
                },
                {
                    "label": "atm",
                    "value": "atm"
                }
            ],
            "defaultUnit": {
                "label": "psia",
                "value": "psia"
            }
        },
        {
            "fieldName": "PumpPressureAtNormalProcessFlow",
            "label": "Pump Pressure At Normal Process Flow",
            "type": "inputUom",
            "UomFieldName": "PressureUOM",
            "fieldDisplayOrder": 3,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Normal Pump Pressure[Ppn]",
            "grid": 4,
            "dimensionName": [
                "pressure"
            ],
            "validations": [
                {
                    "target": {
                        "id": "PumpPressureAtRecirculationFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtNormalProcessFlow && !PumpPressureAtRecirculationFlow && PumpPressureAtNormalProcessFlow>PumpPressureAtRecirculationFlow",
                        "expressionReqFields": [
                            "PumpPressureAtNormalProcessFlow",
                            "PumpPressureAtRecirculationFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtRecirculationFlowgte"}
                },
                {
                    "target": {
                        "id": "PumpPressureAtRecirculationFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtRecirculationFlow && !PumpPressureAtNormalProcessFlow && PumpPressureAtRecirculationFlow<PumpPressureAtNormalProcessFlow/4",
                        "expressionReqFields": [
                            "PumpPressureAtNormalProcessFlow",
                            "PumpPressureAtRecirculationFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtNormalProcessFlowlt25"}
                },
                {
                    "target": {
                        "id": "PumpPressureAtZeroFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtNormalProcessFlow && !PumpPressureAtZeroFlow && PumpPressureAtNormalProcessFlow>PumpPressureAtZeroFlow",
                        "expressionReqFields": [
                            "PumpPressureAtZeroFlow",
                            "PumpPressureAtNormalProcessFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtNormalProcessFlowgtppazf"}
                }
            ],
            "options": [
                {
                    "label": "psia",
                    "value": "psia"
                },
                {
                    "label": "kPa",
                    "value": "kPa"
                },
                {
                    "label": "bar",
                    "value": "bar"
                },
                {
                    "label": "atm",
                    "value": "atm"
                }
            ],
            "defaultUnit": {
                "label": "psia",
                "value": "psia"
            }
        },
        {
            "fieldName": "PumpPressureAtRecirculationFlow",
            "label": "Pump Pressure At Recirculation Flow",
            "type": "inputUom",
            "UomFieldName": "PressureUOM",
            "fieldDisplayOrder": 4,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Recirculation Pump Pressure [Ppbp]",
            "grid": 4,
            "dimensionName": [
                "pressure"
            ],
            "validations": [
                {
                    "target": {
                        "id": "PumpPressureAtNormalProcessFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtNormalProcessFlow && !PumpPressureAtRecirculationFlow && PumpPressureAtNormalProcessFlow>PumpPressureAtRecirculationFlow",
                        "expressionReqFields": [
                            "PumpPressureAtNormalProcessFlow",
                            "PumpPressureAtRecirculationFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtRecirculationFlowgte"}
                },
                {
                    "target": {
                        "id": "PumpPressureAtNormalProcessFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtRecirculationFlow && !PumpPressureAtNormalProcessFlow && PumpPressureAtRecirculationFlow<PumpPressureAtNormalProcessFlow/4",
                        "expressionReqFields": [
                            "PumpPressureAtNormalProcessFlow",
                            "PumpPressureAtRecirculationFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtNormalProcessFlowlt25"}
                },
                {
                    "target": {
                        "id": "PumpPressureAtRecirculationFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtNormalProcessFlow && !PumpPressureAtRecirculationFlow && PumpPressureAtNormalProcessFlow > PumpPressureAtRecirculationFlow",
                        "expressionReqFields": [
                            "PumpPressureAtNormalProcessFlow",
                            "PumpPressureAtRecirculationFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"PumpPressureAtZeroFlowgtppbp"}
                }
            ],
            "options": [
                {
                    "label": "psia",
                    "value": "psia"
                },
                {
                    "label": "kPa",
                    "value": "kPa"
                },
                {
                    "label": "bar",
                    "value": "bar"
                },
                {
                    "label": "atm",
                    "value": "atm"
                }
            ],
            "defaultUnit": {
                "label": "psia",
                "value": "psia"
            }
        },
        {
            "fieldName": "ExistingBypassLinePressure",
            "label": "Existing Bypass Line Pressure",
            "type": "inputUom",
            "UomFieldName": "PressureUOM",
            "fieldDisplayOrder": 5,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Existing BLP[Pabp]",
            "grid": 4,
            "dimensionName": [
                "pressure"
            ],
            "validations": [
                {
                    "target": {
                        "id": "PumpPressureAtRecirculationFlow",
                        "symbol": "Calculate",
                        "expression": "!ExistingBypassLinePressure && !PumpPressureAtRecirculationFlow && ExistingBypassLinePressure > PumpPressureAtRecirculationFlow",
                        "expressionReqFields": [
                            "ExistingBypassLinePressure",
                            "PumpPressureAtRecirculationFlow"
                        ],
                        "value": true
                    },
                   "message":{"type":"error","message":"PABPgtPPBP"}
                },
                {
                    "target": {
                        "id": "PumpPressureAtNormalProcessFlow",
                        "symbol": "Calculate",
                        "expression": "!PumpPressureAtNormalProcessFlow && !ExistingBypassLinePressure && PumpPressureAtNormalProcessFlow < ExistingBypassLinePressure",
                        "expressionReqFields": [
                            "PumpPressureAtNormalProcessFlow",
                            "ExistingBypassLinePressure"
                        ],
                        "value": true
                    },
                   "message":{"type":"error","message":"PABPgtPPN"}
                }
            ],
            "options": []
        }
    ]
},
