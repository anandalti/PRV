{
    "sectionName": "pumpFlow",
    "sectionLabel": "Pump Flow",
    "displayType": "form",
    "displayOrder": 8,
    "fields": [
        {
            "fieldName": "NormalProcess",
            "label": "Normal Process",
            "type": "inputUom",
            "UomFieldName": "FlowCapacityUOM",
            "fieldDisplayOrder": 1,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Normal Pump Flow Required[VlnReq]",
            "grid": 4,
            "dimensionName": [
                "liquidvolflow","massflow"
            ],
            "validations": [
                {
                    "id":"NormalProcess",
                    "minValue": 0,
                    "message":{"type":"error","message":"NormalProcessgt0"}
                }
            ],
            "options": [
                {
                    "label": "SCFD",
                    "value": "SCFD"
                },
                {
                    "label": "SCFH",
                    "value": "SCFH"
                },
                {
                    "label": "SCFM",
                    "value": "SCFM"
                },
                {
                    "label": "SCFS",
                    "value": "SCFS"
                }
            ],
            "defaultUnit": {
                "label": "SCFM",
                "value": "SCFM"
            }
        },
        {
            "fieldName": "MaximumProcess",
            "label": "Maximum Process",
            "type": "inputUom",
            "UomFieldName": "FlowCapacityUOM",
            "fieldDisplayOrder": 2,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Maximun Pump Flow Required[VlmReq]",
            "grid": 4,
            "dimensionName": [
                "liquidvolflow","massflow"
            ],
            "validations": [
                {
                    "id":"MaximumProcess",
                    "minValue": 0,
                    "message":{"type":"error","message":"MaximumProcessgt0"} 
                },
                {
                    "target": {
                        "id": "MaximumProcess",
                        "symbol": "Calculate",
                        "expression": "NormalProcess > MaximumProcess",
                        "expressionReqFields": [
                            "MaximumProcess",
                            "NormalProcess"
                        ],
                        "value": true
                    },
                   "message":{"type":"error","message":"NormalProcessltmp"}
                },
                {
                    "target": {
                        "id": "MaximumProcess",
                        "symbol": "Calculate",
                        "expression": "MaximumProcess>NormalProcess * 2",
                        "expressionReqFields": [
                            "MaximumProcess",
                            "NormalProcess"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"MaximumProcessinto2"}
                }
            ],
            "options": [
                {
                    "label": "SCFD",
                    "value": "SCFD"
                },
                {
                    "label": "SCFH",
                    "value": "SCFH"
                },
                {
                    "label": "SCFM",
                    "value": "SCFM"
                },
                {
                    "label": "SCFS",
                    "value": "SCFS"
                }
            ],
            "defaultUnit": {
                "label": "SCFM",
                "value": "SCFM"
            }
        },
        {
            "fieldName": "Recirculation",
            "label": "Recirculation",
            "type": "inputUom",
            "UomFieldName": "FlowCapacityUOM",
            "fieldDisplayOrder": 3,
            "mandatory": true,
            "defaultValue": "",
            "disabled": false,
            "visible": true,
            "infoText": "Recirculation  Pump Flow Required[VlbpReq]",
            "grid": 4,
            "dimensionName": [
                "liquidvolflow","massflow"
            ],
            "validations": [
                {
                    "id":"Recirculation",
                    "minValue": 0,
                    "message":{"type":"error","message":"Recirculationgt0"}
                },
                {
                    "target": {
                        "id": "Recirculation",
                        "symbol": "Calculate",
                        "expression": "Recirculation > 0.5 * NormalProcess",
                        "expressionReqFields": [
                            "Recirculation",
                            "NormalProcess"
                        ],
                        "value": true
                    },
                   "message":{"type":"warning","message":"Recirculationgtfity"}
                }
            ],
            "options": []
        }
    ]
